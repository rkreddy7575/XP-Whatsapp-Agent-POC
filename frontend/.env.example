# Mudhra Owner Dashboard - Frontend Environment Variables
# Copy this file to .env.production or .env.local if configuring custom endpoints.

# API Base URL for the backend service:
# - When deploying behind an Nginx reverse proxy (standard Docker setup), leave unset or set to /api
# - When frontend is hosted separately from backend (e.g., Vercel / Netlify / Cloudflare Pages):
#   Set to the public URL of your backend's API endpoint:
# VITE_API_BASE=https://api.yourdomain.com/api
