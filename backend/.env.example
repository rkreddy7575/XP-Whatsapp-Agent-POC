# Meta WhatsApp Cloud API Credentials
# Replace the placeholder values with your actual credentials from Meta Developer Portal

WHATSAPP_VERIFY_TOKEN=replace_with_your_verify_token
WHATSAPP_ACCESS_TOKEN=replace_with_your_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_your_business_account_id
META_GRAPH_API_VERSION=replace_with_version_from_meta

# Google Gemini API Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Owner Dashboard Authentication (Single-Tenant Pilot)
DASHBOARD_API_KEY=replace_with_secure_random_token
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace_with_strong_password

# Meta App Secret (for X-Hub-Signature-256 webhook validation)
# Obtain this from Meta Developer Dashboard: App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=replace_with_real_meta_app_secret

# Optional Production Server Settings
# CORS_ORIGINS=https://dashboard.yourdomain.com,http://localhost:5173
# DATABASE_PATH=/app/data/app.db

# Supabase PostgreSQL Configuration (Placeholders only — NEVER commit real secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres
